{
  "name": "aihc-hackage",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "scripts/build-components.sh && npm run build:shell",
    "build:shell": "node scripts/build-shell.mjs",
    "dev": "wrangler dev --config wrangler.jsonc --config wrangler.docs.jsonc",
    "test": "node --experimental-wasm-jspi --test test/*.test.mjs",
    "check": "npm run build:shell && wrangler deploy --dry-run --outdir dist && wrangler deploy --config wrangler.docs.jsonc --dry-run --outdir dist-docs && npm test && node --experimental-wasm-jspi --test planner/test.mjs",
    "deploy": "npm run build:shell && npm run deploy:built",
    "deploy:built": "wrangler d1 migrations apply DB --remote && wrangler deploy --config wrangler.docs.jsonc && wrangler deploy",
    "check:planner": "scripts/check-planner.sh",
    "build:planner": "scripts/build-planner.sh"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@bytecodealliance/jco-transpile": "0.16.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20261001.0-alpha",
    "wrangler": "4.147.0"
  }
}
