cabal-version: 3.0
name: sample
version: 1.2.0
synopsis: A small package
description: Sample metadata with Unicode λ.
license: BSD-3-Clause
flag extra
  default: False
  manual: True
library
  exposed-modules: Sample.Main
  build-depends: base >=4.16 && <5
  if flag(extra)
    exposed-modules: Sample.Extra
    build-depends: text >=2
  else
    build-depends: bytestring
  default-language: Haskell2010
